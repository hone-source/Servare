<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de copia de seguridad para Android 11 e inferior.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- La sesión está cifrada con una clave del Keystore que no viaja con la copia:
         restaurarla en otro equipo dejaría un token ilegible -->
    <exclude domain="file" path="datastore/sesion.preferences_pb" />
</full-backup-content>
