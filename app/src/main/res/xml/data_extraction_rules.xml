<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de copia de seguridad y transferencia para Android 12 y superior.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- La sesión está cifrada con una clave del Keystore que no viaja con la copia,
         restaurarla en otro equipo dejaría un token ilegible -->
    <cloud-backup>
        <exclude domain="file" path="datastore/sesion.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sesion.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
